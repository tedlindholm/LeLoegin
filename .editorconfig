# editorconfig.org

# top-most EditorConfig file
root = true

[*]
insert_final_newline = true
end_of_line = lf
indent_style = tab
indent_size = 4
trim_trailing_whitespace = true

[*.js]
trim_trailing_whitespace = true

[*.less]
trim_trailing_whitespace = false

[*.md]
# Ending with two spaces creates a line break in markdown
trim_trailing_whitespace = false

[*.yml]
# YAML files must use spaces as indentation
indent_style = space
indent_size = 2


[*.cs]
# https://github.com/MicrosoftDocs/visualstudio-docs/blob/master/docs/ide/editorconfig-code-style-settings-reference.md
#. NET source code analysis https://learn.microsoft.com/en-us/dotnet/fundamentals/code-analysis/overview #
# Complete list of shipped analyzers https://github.com/dotnet/roslyn-analyzers/blob/main/src/NetAnalyzers/Core/AnalyzerReleases.Shipped.md #
# Code style rules https://learn.microsoft.com/en-us/dotnet/fundamentals/code-analysis/style-rules/ #

