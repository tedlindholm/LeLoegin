<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
		<StaticWebAssetBasePath>/</StaticWebAssetBasePath>
		<AddRazorSupportForMvc>true</AddRazorSupportForMvc>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>LeLøgin</RootNamespace>
    <AssemblyName>LeLøgin</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Supplied by Umbraco.Cms.Targets when referencing the Umbraco.Cms meta-package; declared
         here because this project references only the Umbraco assemblies it actually uses. -->
    <Using Include="Umbraco.Cms.Core.DependencyInjection" />
    <Using Include="Umbraco.Extensions" />
  </ItemGroup>

  <PropertyGroup>
    <Version>18.0.0-rc.1</Version>
    <PackageId>LeLøgin</PackageId>
    <Authors>Le Løgin contributors</Authors>
    <Description>Le Løgin is a distributable Umbraco package for managing the backoffice login-screen image from a Settings-integrated product area.</Description>
    <PackageReadmeFile>readme.md</PackageReadmeFile>
    <PackageTags>umbraco;backoffice;login-screen;settings;branding</PackageTags>
    <Product>LeLøgin</Product>
    <Title>Le Løgin</Title>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <PropertyGroup>
    <StaticWebAssetsGetBuildAssetsTargets>GenerateStaticWebAssetsManifest;GetCurrentProjectBuildStaticWebAssetItems</StaticWebAssetsGetBuildAssetsTargets>
  </PropertyGroup>

  <ItemGroup>
    <!-- PrivateAssets="all" pattern: This package is compiled against Umbraco 18.0 but does NOT
         declare Umbraco as a transitive dependency. The installed host (consumer's Umbraco site) owns
         and supplies its own Umbraco version at runtime (18.x or 19.x). This allows LeLøgin to
         work with multiple Umbraco majors without the consumer being locked to a specific version.
         See: docs/architecture.md#host-owned-dependencies -->
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" PrivateAssets="all" />
    <!-- Keep vulnerable transitive versions from the 18.0 floor out of this package's consumers. -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.11.0" PrivateAssets="all" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.11" PrivateAssets="all" />
    <!-- Build-time only. The host supplies the runtime assemblies and owns their versions.
         - Api.Management: transitively covers Core, Infrastructure, Web.Common, Api.Common
         - Imaging.ImageSharp: provides middleware options and HMAC signing utilities for LoginScreenImageUrlBuilder -->
    <PackageReference Include="Umbraco.Cms.Api.Management" Version="18.0.0" PrivateAssets="all" />
    <PackageReference Include="Umbraco.Cms.Imaging.ImageSharp" Version="18.0.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Don't include the client folder as part of the NuGet package build. -->
    <Content Remove="Client\**" />

    <!-- Exclude repository tooling, editor schemas and local emulator state from the package. -->
    <Content Remove="AzuriteConfig;AzuriteConfig\**;__azurite_db_*.json;__blobstorage__\**;__queuestorage__\**;appsettings-schema.json;appsettings-schema.*.json;umbraco-package-schema.json;skills-lock.json" />
    <None Remove="AzuriteConfig;AzuriteConfig\**;__azurite_db_*.json;__blobstorage__\**;__queuestorage__\**;appsettings-schema.json;appsettings-schema.*.json;umbraco-package-schema.json;skills-lock.json" />

    <!-- Exclude generated artefacts and scratch repro projects from SDK default globs. -->
    <Compile Remove="artifacts\**" />
    <Content Remove="artifacts\**" />
    <None Remove="artifacts\**" />

    <!-- Exclude test projects — their own .csproj files handle compilation -->
    <Compile Remove="*.Tests\**" />
    <Content Remove="*.Tests\**" />
    <None Remove="*.Tests\**" />

    <!-- Exclude sibling adapter projects — their own .csproj files handle compilation -->
    <Compile Remove="LeLøgin.AzureBlob\**" />
    <Content Remove="LeLøgin.AzureBlob\**" />
    <None Remove="LeLøgin.AzureBlob\**" />

    <!-- Keep the Umbraco package manifest visible in the solution without packing it twice. -->
    <None Include="Client\public\umbraco-package.json" Pack="false" />
    <None Include="readme.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <Target Name="PrepareLeLøginClientStaticAssets" BeforeTargets="ResolveProjectStaticWebAssets" Condition="'$(_LeLoginClientAssetsBuilt)' != 'true'">
    <Message Importance="high" Text="Synchronising Le Løgin package versions and building client assets." />
    <RemoveDir Directories="$(MSBuildProjectDirectory)/wwwroot/App_Plugins/le-løgin" />
    <Exec Command="node scripts/sync-package-version.mjs &quot;$(Version)&quot;" WorkingDirectory="$(MSBuildProjectDirectory)/Client" />
    <Exec Command="pnpm build" WorkingDirectory="$(MSBuildProjectDirectory)/Client" />

    <ItemGroup>
      <_LeLoginGeneratedContent Include="@(Content)" Condition="$([System.String]::Copy('%(Identity)').Replace('\', '/').StartsWith('wwwroot/App_Plugins/le-løgin/'))" />
      <Content Remove="@(_LeLoginGeneratedContent)" />
      <Content Include="wwwroot\App_Plugins\le-løgin\**" />
    </ItemGroup>

    <PropertyGroup>
      <_LeLoginClientAssetsBuilt>true</_LeLoginClientAssetsBuilt>
    </PropertyGroup>
  </Target>

</Project>
