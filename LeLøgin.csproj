<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
		<StaticWebAssetBasePath>/</StaticWebAssetBasePath>
		<AddRazorSupportForMvc>true</AddRazorSupportForMvc>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>LeLøgin</RootNamespace>
    <AssemblyName>LeLøgin</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Supplied by Umbraco.Cms.Targets when referencing the Umbraco.Cms meta-package; declared
         here because this project references only the Umbraco assemblies it actually uses. -->
    <Using Include="Umbraco.Cms.Core.DependencyInjection" />
    <Using Include="Umbraco.Extensions" />
  </ItemGroup>

  <PropertyGroup>
    <Version>$(LeLoginPackageVersion)</Version>
    <PackageId>LeLøgin</PackageId>
    <Authors>Le Løgin contributors</Authors>
    <Description>Le Løgin is a distributable Umbraco package for managing the backoffice login-screen image from a Settings-integrated product area.</Description>
    <PackageReadmeFile>readme.md</PackageReadmeFile>
    <PackageTags>umbraco;backoffice;login-screen;settings;branding</PackageTags>
    <Product>LeLøgin</Product>
    <Title>Le Løgin</Title>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <PropertyGroup>
    <StaticWebAssetsGetBuildAssetsTargets>GenerateStaticWebAssetsManifest;GetCurrentProjectBuildStaticWebAssetItems</StaticWebAssetsGetBuildAssetsTargets>
  </PropertyGroup>

  <ItemGroup>
    <!-- PrivateAssets="all": compiled against the Umbraco major selected by $(UmbracoMajor)
         in Directory.Build.props. The host supplies these assemblies at runtime and the package
         does not carry them as dependencies. See docs/architecture.md#host-owned-dependencies.
         ImageSharp is not referenced directly. Umbraco.Cms.Imaging.ImageSharp brings it, and a
         direct SixLabors.ImageSharp 3.2 reference would require a Six Labors license key for
         Release builds. Enforcement applies to direct references only. -->
    <!-- Match the selected floor's patched transitive versions. These pins do not flow to the host. -->
    <PackageReference Include="Microsoft.OpenApi" Version="$(OpenApiPackageVersion)" PrivateAssets="all" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="$(CryptographyXmlPackageVersion)" PrivateAssets="all" />
    <!-- Umbraco 17.7.2 still resolves MessagePack 3.1.8 (GHSA-qhrr-8q5h-9q3h). The pin stays inside this build. -->
    <PackageReference Include="MessagePack" Version="$(MessagePackPackageVersion)" PrivateAssets="all" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="$(SwashbucklePackageVersion)" PrivateAssets="all" Condition="'$(UmbracoMajor)' == '17'" />
    <!-- Build-time only. The host supplies the runtime assemblies and owns their versions.
         - Api.Management: transitively covers Core, Infrastructure, Web.Common, Api.Common
         - Imaging.ImageSharp: provides middleware options and HMAC signing utilities for LoginScreenImageUrlBuilder -->
    <PackageReference Include="Umbraco.Cms.Api.Management" Version="$(UmbracoPackageVersion)" PrivateAssets="all" />
    <PackageReference Include="Umbraco.Cms.Imaging.ImageSharp" Version="$(UmbracoPackageVersion)" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Don't include the client folder as part of the NuGet package build. -->
    <Content Remove="Client\**" />

    <!-- Exclude repository tooling, editor schemas and local emulator state from the package. -->
    <Content Remove="AzuriteConfig;AzuriteConfig\**;__azurite_db_*.json;__blobstorage__\**;__queuestorage__\**;appsettings-schema.json;appsettings-schema.*.json;umbraco-package-schema.json;skills-lock.json" />
    <None Remove="AzuriteConfig;AzuriteConfig\**;__azurite_db_*.json;__blobstorage__\**;__queuestorage__\**;appsettings-schema.json;appsettings-schema.*.json;umbraco-package-schema.json;skills-lock.json" />

    <!-- Exclude generated artefacts and scratch repro projects from SDK default globs. -->
    <Compile Remove="artifacts\**" />
    <Content Remove="artifacts\**" />
    <None Remove="artifacts\**" />

    <Compile Remove="Core\Api\ApiConfiguration.OpenApi.cs" Condition="'$(UmbracoMajor)' != '18'" />
    <Compile Remove="Core\Api\ApiConfiguration.Swashbuckle.cs" Condition="'$(UmbracoMajor)' != '17'" />

    <!-- Exclude test projects — their own .csproj files handle compilation -->
    <Compile Remove="*.Tests\**" />
    <Content Remove="*.Tests\**" />
    <None Remove="*.Tests\**" />

    <!-- Exclude sibling adapter projects — their own .csproj files handle compilation -->
    <Compile Remove="LeLøgin.AzureBlob\**" />
    <Content Remove="LeLøgin.AzureBlob\**" />
    <None Remove="LeLøgin.AzureBlob\**" />

    <!-- Keep the Umbraco package manifest visible in the solution without packing it twice. -->
    <None Include="Client\public\umbraco-package.json" Pack="false" />
    <None Include="readme.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <Target Name="PrepareLeLøginClientStaticAssets" BeforeTargets="ResolveProjectStaticWebAssets" Condition="'$(_LeLoginClientAssetsBuilt)' != 'true'">
    <Message Importance="high" Text="Synchronising Le Løgin package versions and building client assets." />
    <RemoveDir Directories="$(MSBuildProjectDirectory)/wwwroot/App_Plugins/le-løgin" />
    <Exec Command="node scripts/sync-package-version.mjs &quot;$(Version)&quot;" WorkingDirectory="$(MSBuildProjectDirectory)/Client" />
    <Exec Command="pnpm build" WorkingDirectory="$(MSBuildProjectDirectory)/Client" />

    <!-- Match on the ASCII prefix. A full path, or ø stored in a different Unicode form, does not
         start with the project-relative folder and would leave the deleted Vite manifest in @(Content). -->
    <ItemGroup>
      <_LeLoginGeneratedContent Include="@(Content)" Condition="$([System.String]::Copy('%(Identity)').Replace('\', '/').Contains('App_Plugins/le-'))" />
      <Content Remove="@(_LeLoginGeneratedContent)" />
      <Content Include="wwwroot\App_Plugins\le-løgin\**" Exclude="wwwroot\App_Plugins\le-løgin\.vite\**" />
    </ItemGroup>

    <!-- The client output is replaced on every build. Keep the previous compression cache from
         pointing at a file the Vite plugin has already deleted. -->
    <Delete Files="$(IntermediateOutputPath)rpswa.dswa.cache.json;$(IntermediateOutputPath)rbcswa.dswa.cache.json" />
    <RemoveDir Directories="$(IntermediateOutputPath)compressed" />

    <PropertyGroup>
      <_LeLoginClientAssetsBuilt>true</_LeLoginClientAssetsBuilt>
    </PropertyGroup>
  </Target>

</Project>
