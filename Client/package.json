{
	"name": "le-login",
	"description": "Le Løgin Umbraco client assets and build tooling.",
	"private": false,
	"version": "18.0.0-rc.1",
	"type": "module",
	"engines": {
		"node": ">=24.13"
	},
	"scripts": {
		"dev": "tsc && vite build --watch",
		"build": "tsc && vite build",
		"fmt": "oxfmt lib scripts types vite.config.ts oxlint.config.ts",
		"fmt:check": "oxfmt --check lib scripts types vite.config.ts oxlint.config.ts",
		"generate-client": "node scripts/generate-openapi.js https://localhost:5001/umbraco/openapi/le-løgin-api-v1.json",
		"sync-version": "node scripts/sync-package-version.mjs",
		"lint": "oxlint --max-warnings 0",
		"lint:fix": "oxlint --fix --max-warnings 0",
		"test": "vitest run",
		"test:unit": "vitest run --passWithNoTests --exclude '**/*.integration.{spec,test}.{ts,tsx}'",
		"test:integration": "vitest run --passWithNoTests .integration.",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@hey-api/openapi-ts": "^0.99.0",
		"@types/node": "^24.13.2",
		"@umbraco-cms/backoffice": "18.0.0",
		"@umbraco-ui/uui": "^2.0.0",
		"chalk": "^5.6.2",
		"lightningcss": "^1.27.0",
		"oxfmt": "^0.55.0",
		"oxlint": "^1.70.0",
		"typescript": "^6.0.3",
		"uuid": "^14.0.0",
		"vite": "^8.0.16",
		"vitest": "^4.1.9"
	},
	"packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621"
}
