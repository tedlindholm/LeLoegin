{
	"name": "le-login",
	"description": "Le Løgin Umbraco client assets and build tooling.",
	"private": false,
	"version": "18.0.0",
	"type": "module",
	"exports": {
		"./entrypoint": "./lib/index.ts"
	},
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "tsc && vite build --watch",
		"build": "tsc && vite build",
		"fmt": "oxfmt lib scripts types vite.config.ts oxlint.config.ts",
		"fmt:check": "oxfmt --check lib scripts types vite.config.ts oxlint.config.ts",
		"generate-client": "node scripts/generate-openapi.js https://localhost:5001/umbraco/swagger/le-løgin-api-v1/swagger.json",
		"sync-version": "node scripts/sync-package-version.mjs",
		"lint": "oxlint --max-warnings 0",
		"lint:fix": "oxlint --fix --max-warnings 0",
		"test": "vitest run",
		"test:unit": "vitest run --passWithNoTests --exclude '**/*.integration.{spec,test}.{ts,tsx}'",
		"test:integration": "vitest run --passWithNoTests .integration.",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@hey-api/openapi-ts": "^0.99.0",
		"@types/node": "^24.13.2",
		"@umbraco-cms/backoffice": "17.4.2",
		"chalk": "^5.6.2",
		"lightningcss": "^1.27.0",
		"oxfmt": "^0.55.0",
		"oxlint": "^1.70.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.9"
	},
	"packageManager": "pnpm@11.3.0+sha512.2c403d6594527287672b1f7056343a1f7c3634036a67ffabfcc2b3d7595d843768f8787148d1b57cf7956c90606bbd192857c363af19e96d2d0ec9ec5741d215"
}
