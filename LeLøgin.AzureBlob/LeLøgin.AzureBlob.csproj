<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>LeLøgin.AzureBlob</RootNamespace>
    <AssemblyName>LeLøgin.AzureBlob</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Supplied by Umbraco.Cms.Targets when referencing the Umbraco.Cms meta-package; declared
         here because LeLøgin references only the Umbraco assemblies it actually uses. -->
    <Using Include="Umbraco.Cms.Core.DependencyInjection" />
    <Using Include="Umbraco.Extensions" />
  </ItemGroup>

  <PropertyGroup>
    <Version>18.0.0-rc.1</Version>
    <PackageId>LeLøgin.AzureBlob</PackageId>
    <Authors>Le Løgin contributors</Authors>
    <Description>Azure Blob Storage adapter for Le Løgin. Routes the asset and publish file systems through Umbraco.StorageProviders.AzureBlob so backoffice login-screen assets can live in blob storage instead of the local disk.</Description>
    <PackageReadmeFile>readme.md</PackageReadmeFile>
    <PackageTags>umbraco;backoffice;login-screen;azure;blob-storage;le-løgin</PackageTags>
    <Product>LeLøgin.AzureBlob</Product>
    <Title>Le Løgin — Azure Blob adapter</Title>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <!-- PrivateAssets="all" pattern: Build-time only. The host supplies and owns these runtime
         assemblies; see LeLøgin.csproj for rationale. This adapter works with any Umbraco 18+
         and any compatible StorageProviders.AzureBlob version the host has installed. -->
    <PackageReference Include="Umbraco.StorageProviders.AzureBlob" Version="18.0.0" PrivateAssets="all" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.11" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LeLøgin.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="readme.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
