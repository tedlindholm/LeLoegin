<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>LeLøgin.AzureBlob</RootNamespace>
    <AssemblyName>LeLøgin.AzureBlob</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Supplied by Umbraco.Cms.Targets when referencing the Umbraco.Cms meta-package; declared
         here because LeLøgin references only the Umbraco assemblies it actually uses. -->
    <Using Include="Umbraco.Cms.Core.DependencyInjection" />
    <Using Include="Umbraco.Extensions" />
  </ItemGroup>

  <PropertyGroup>
    <Version>$(LeLoginPackageVersion)</Version>
    <PackageId>LeLøgin.AzureBlob</PackageId>
    <Authors>Le Løgin contributors</Authors>
    <Description>Azure Blob Storage adapter for Le Løgin. Routes the asset and publish file systems through Umbraco.StorageProviders.AzureBlob so backoffice login-screen assets can live in blob storage instead of the local disk.</Description>
    <PackageReadmeFile>readme.md</PackageReadmeFile>
    <PackageTags>umbraco;backoffice;login-screen;azure;blob-storage;le-løgin</PackageTags>
    <Product>LeLøgin.AzureBlob</Product>
    <Title>Le Løgin — Azure Blob adapter</Title>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <!-- PrivateAssets="all": build-time only. The host supplies the storage provider that matches
         its Umbraco major. Versions come from Directory.Build.props. -->
    <!-- The storage provider's dependency range starts at its own major's 0 patch.
         Reference this track's Umbraco version directly so that floor does not clash with LeLøgin. -->
    <PackageReference Include="Umbraco.Cms.Web.Common" Version="$(UmbracoPackageVersion)" PrivateAssets="all" />
    <PackageReference Include="Umbraco.StorageProviders.AzureBlob" Version="$(UmbracoBlobPackageVersion)" PrivateAssets="all" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="$(CryptographyXmlPackageVersion)" PrivateAssets="all" />
    <!-- AzureBlob 18.0.0 pulls Umbraco 18.0, which resolves MessagePack 3.1.7 (GHSA-qhrr-8q5h-9q3h). -->
    <PackageReference Include="MessagePack" Version="$(MessagePackPackageVersion)" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LeLøgin.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="readme.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
