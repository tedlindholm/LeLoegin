<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>LeLøgin.AzureBlob</RootNamespace>
    <AssemblyName>LeLøgin.AzureBlob</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Supplied by Umbraco.Cms.Targets when referencing the Umbraco.Cms meta-package; declared
         here because LeLøgin references only the Umbraco assemblies it actually uses. -->
    <Using Include="Umbraco.Cms.Core.DependencyInjection" />
    <Using Include="Umbraco.Extensions" />
  </ItemGroup>

  <PropertyGroup>
    <Version>1.2.2</Version>
    <PackageId>LeLøgin.AzureBlob</PackageId>
    <Authors>Le Løgin contributors</Authors>
    <Description>Azure Blob Storage adapter for Le Løgin. Routes the asset and publish file systems through Umbraco.StorageProviders.AzureBlob so backoffice login-screen assets can live in blob storage instead of the local disk.</Description>
    <PackageReadmeFile>readme.md</PackageReadmeFile>
    <PackageTags>umbraco;backoffice;login-screen;azure;blob-storage;le-løgin</PackageTags>
    <Product>LeLøgin.AzureBlob</Product>
    <Title>Le Løgin — Azure Blob adapter</Title>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Umbraco.StorageProviders.AzureBlob" Version="18.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LeLøgin.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="readme.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
